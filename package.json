{
  "name": "gift188-three",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "188号礼物 — three.js 版。3D 骑行叙事游戏，面向低配置设备优化。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview --port 4173",
    "preview:cf": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "probe": "node tools/probe.mjs",
    "data:extract": "node tools/extract-data.mjs",
    "assets:tex": "node tools/compress-textures.mjs",
    "assets:geo": "node tools/optimize-assets.mjs",
    "assets:retax": "node tools/retax.mjs",
    "assets:title": "node tools/make-titleart.mjs --write",
    "assets:font": "node tools/subset-font.mjs",
    "assets:all": "npm run assets:font && npm run assets:tex && npm run assets:geo",
    "promo:wt-probe": "node tools/wt-probe.mjs",
    "promo:walkthrough": "node tools/walkthrough.mjs",
    "verify": "node tools/verify-all.mjs"
  },
  "dependencies": {
    "subset-font": "^2.9.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.1.0",
    "@gltf-transform/extensions": "^4.1.0",
    "@gltf-transform/functions": "^4.1.0",
    "@types/three": "^0.169.0",
    "draco3dgltf": "^1.5.7",
    "esbuild": "^0.21.5",
    "meshoptimizer": "^0.22.0",
    "playwright-core": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "wrangler": "^4.147.0"
  }
}
