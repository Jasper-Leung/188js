{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "188号礼物",
  "version": "1.0.0",
  "identifier": "com.jasperleung.gift188",

  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5180",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "188号礼物 · Gift No.188",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
